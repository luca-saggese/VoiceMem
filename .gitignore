# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
# I test di bozza locali non entrano nel repository, ma i due pacchetti menzionati nelle due sezioni del README per l'auto-verifica sì
tests/*
!tests/test_offline_engine.py
!tests/test_streaming.py
!tests/test_demo_from_zero.py
!tests/test_nemotron_asr.py

# Dati runtime: database memoria, risultati valutazione, archivio registrazioni
results/
memory/
out/

# Ambiente e configurazione locale
.env
.venv/
.claude/
.DS_Store

# Pesi dei modelli: scaricati da scripts/download_models.sh, non nel repository
*.onnx
*.ckpt
*.pt
*.pth
*.safetensors
*.bin
# Directory dei modelli per scopo (insieme a tokens.txt / test_wavs come asset del pacchetto);
# tutto ciò che è in models/ viene scaricato da scripts/download_models.sh, non nel repository
models/vad/
models/asr/
models/speaker/
models/embedding/
models/scene/
models/emotion/
models/tts/
models/slm/
models/reply_adapter/

# Fork demo locale e script seed personali
demo_local/
scripts/seed_*.py

# Wrapper desktop Electron
node_modules/

# Directory radice memoria predefinita (se non passi memory_root finisce nella directory corrente)
voicemem_memory/
examples/example_memory/
# Spazio memoria: la **struttura delle directory** entra nel repository, i suoi dati no.
# Dopo il clone ci sono due cartelle vuote — demo (per eseguire il demo) e myvoicemem (le tue),
# chi esegue accumula autonomamente, non spingi le memorie di nessuno.
voicemem_memoryspace/*
!voicemem_memoryspace/demo/
!voicemem_memoryspace/myvoicemem/
voicemem_memoryspace/demo/*
voicemem_memoryspace/myvoicemem/*
!voicemem_memoryspace/demo/.gitkeep
!voicemem_memoryspace/myvoicemem/.gitkeep
